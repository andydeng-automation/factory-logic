---
const { title = 'Factory Logic — Industrial Automation & Manufacturing', description = 'Understand. Build. Automate.' } = Astro.props;
const path = Astro.url.pathname;
const home = import.meta.env.BASE_URL;
const links = [
  ['Home', `${home}#home`], ['Automation', `${home}#automation`], ['Machine Vision', `${home}#machine-vision`],
  ['Manufacturing', `${home}#manufacturing`], ['Projects', `${home}#projects`], ['Videos', `${home}#videos`], ['About', `${home}#about`],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f5f2" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${home}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${home}#home`} aria-label="Factory Logic home">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="brand-name">FACTORY<span>LOGIC</span></span>
      </a>
      <nav class="nav" aria-label="Main navigation">
        {links.map(([label, href]) => <a class:list={{ active: path === href }} href={href}>{label}</a>)}
      </nav>
      <a class="header-cta" href={`${home}#articles`}>Explore the fieldnotes <span>↗</span></a>
    </header>
    <slot />
    <footer class="footer">
      <a class="brand footer-brand" href={`${home}#home`}><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span class="brand-name">FACTORY<span>LOGIC</span></span></a>
      <p>Industrial Automation &amp; Manufacturing</p>
      <span class="footer-tag">Understand. Build. Automate.</span>
      <small>© {new Date().getFullYear()} Andy Deng</small>
    </footer>
  </body>
</html>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
  :root{--ink:#172b3b;--muted:#62717a;--paper:#f4f5f2;--white:#fff;--line:#dce2df;--orange:#ea6538;--teal:#266c69;--pale:#e9eeeb;font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none;text-rendering:optimizeLegibility}
  *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0}a{color:inherit;text-decoration:none}.site-header{height:78px;padding:0 clamp(20px,5vw,76px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:rgba(244,245,242,.94);position:sticky;top:0;z-index:10;backdrop-filter:blur(14px)}.brand{display:flex;align-items:center;gap:11px;flex-shrink:0}.brand-mark{width:29px;height:29px;display:flex;align-items:flex-end;gap:3px;padding:5px;border:1.5px solid var(--ink);transform:skew(-8deg)}.brand-mark span{display:block;width:4px;background:var(--orange)}.brand-mark span:nth-child(1){height:8px}.brand-mark span:nth-child(2){height:14px}.brand-mark span:nth-child(3){height:18px}.brand-name{font:800 13px Manrope,sans-serif;letter-spacing:.095em}.brand-name span{font-weight:500;margin-left:4px}.nav{display:flex;gap:clamp(12px,2vw,28px);align-items:center}.nav a{font-size:12px;color:#52616a;white-space:nowrap;transition:color .2s}.nav a:hover,.nav a.active{color:var(--orange)}.header-cta{font:500 11px 'DM Mono',monospace;border:1px solid var(--line);padding:11px 14px;white-space:nowrap}.header-cta span{color:var(--orange);padding-left:8px}.footer{padding:27px clamp(20px,5vw,76px);border-top:1px solid var(--line);display:flex;align-items:center;gap:24px;color:var(--muted);font-size:11px}.footer-brand{color:var(--ink)}.footer p{margin-right:auto}.footer-tag{font:11px 'DM Mono',monospace;color:var(--teal)}.footer small{font-size:10px}
  @media(max-width:1000px){.nav{gap:13px}.nav a{font-size:11px}.header-cta{display:none}}@media(max-width:730px){.site-header{height:auto;min-height:70px;align-items:flex-start;flex-wrap:wrap;padding-top:16px;padding-bottom:11px;gap:14px}.nav{width:100%;overflow:auto;padding:2px 0 5px}.nav a{font-size:11px}.footer{flex-wrap:wrap;gap:13px}.footer p{margin-right:0}.footer-tag{margin-left:auto}}
</style>
