---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const home = import.meta.env.BASE_URL;
const base = home.endsWith('/') ? home : `${home}/`;
const topics = [
  { id: 'automation', number: '01', title: 'Industrial Automation', eyebrow: 'CONTROL · MOTION · SYSTEMS', text: 'From PLC logic and sensors to motion, robotics, and industrial networks. Understand how the pieces work together on the factory floor.', tags: ['PLC & controls', 'Motion systems', 'Industrial networks'] },
  { id: 'machine-vision', number: '02', title: 'Machine Vision', eyebrow: 'OPTICS · LIGHT · IMAGE', text: 'Build a reliable vision system from the image outward: optics, lighting, cameras, calibration, and inspection logic.', tags: ['Optics & lighting', 'Image processing', 'AI vision'] },
  { id: 'manufacturing', number: '03', title: 'Manufacturing Engineering', eyebrow: 'PROCESS · QUALITY · SCALE', text: 'Practical methods for launching, qualifying, measuring, and improving the processes that make products repeatably.', tags: ['NPI & qualification', 'Capability & GR&R', 'Root cause'] },
];
---
<BaseLayout>
  <main>
    <section class="hero" id="home">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> ENGINEERING, MADE UNDERSTANDABLE <span class="eyebrow-rule"></span> 01 / 07</div>
        <h1>Make the<br /><em>complex</em> work.</h1>
        <p class="hero-lede">Industrial automation and manufacturing, explained from first principles to the factory floor.</p>
        <div class="hero-actions"><a class="button-primary" href="#automation">Explore the knowledge base <span>↓</span></a><a class="text-link" href="#about">Meet Andy Deng <span>↗</span></a></div>
        <div class="hero-meta"><span>INDUSTRIAL AUTOMATION</span><b>·</b><span>MACHINE VISION</span><b>·</b><span>MANUFACTURING</span></div>
      </div>
      <div class="hero-visual" aria-label="Illustration of an automated production line">
        <div class="visual-top"><span>FIG. 01 — LINE CONTROL</span><span>SYS / 001</span></div>
        <div class="blueprint">
          <div class="blueprint-grid"></div>
          <svg viewBox="0 0 600 410" role="img" aria-label="Conveyor, robotic arm, sensors, and control system">
            <defs><linearGradient id="panel" x1="0" x2="1"><stop stop-color="#1b3447"/><stop offset="1" stop-color="#294b5b"/></linearGradient></defs>
            <path d="M68 300h462" stroke="#e9a269" stroke-width="8" stroke-linecap="round"/><path d="M95 311v39M505 311v39" stroke="#a9c0ba" stroke-width="6"/><circle cx="126" cy="300" r="17" fill="#f4f5f2" stroke="#1c3b4d" stroke-width="5"/><circle cx="478" cy="300" r="17" fill="#f4f5f2" stroke="#1c3b4d" stroke-width="5"/>
            <rect x="177" y="250" width="86" height="48" rx="3" fill="#e8a06a"/><path d="M190 250l18-20h46l9 20" fill="#f0b883"/><rect x="333" y="230" width="83" height="68" rx="3" fill="#d6e2da" stroke="#203f50" stroke-width="4"/><path d="M345 247h59M345 261h42M345 275h49" stroke="#54766e" stroke-width="4"/>
            <rect x="422" y="108" width="26" height="70" rx="5" fill="url(#panel)"/><path d="M435 178l-38 53" stroke="#1b3447" stroke-width="18" stroke-linecap="round"/><circle cx="435" cy="179" r="13" fill="#ed7147"/><circle cx="397" cy="231" r="13" fill="#ed7147"/><path d="M397 231l-43-23" stroke="#1b3447" stroke-width="15" stroke-linecap="round"/><circle cx="354" cy="208" r="11" fill="#ed7147"/><path d="M354 208l-3 31M341 239h20" stroke="#1b3447" stroke-width="6" stroke-linecap="round"/>
            <path d="M435 108V70h-93" stroke="#85c2ad" stroke-width="2" stroke-dasharray="5 5" fill="none"/><circle cx="342" cy="70" r="4" fill="#85c2ad"/><path d="M127 171v95" stroke="#82c1b0" stroke-width="3"/><path d="M119 171h16M119 266h16" stroke="#82c1b0" stroke-width="3"/><path d="M139 181h36" stroke="#82c1b0" stroke-dasharray="4 4"/><rect x="71" y="164" width="53" height="32" rx="2" fill="#e6f0e9"/><circle cx="84" cy="180" r="5" fill="#ed7147"/><path d="M93 180h22" stroke="#7a9d91" stroke-width="3"/>
            <rect x="471" y="72" width="69" height="39" rx="2" fill="#193447"/><circle cx="485" cy="91" r="4" fill="#ed7147"/><path d="M497 84h34M497 93h26M497 101h19" stroke="#9ec3b8" stroke-width="2"/>
            <text x="68" y="380" fill="#c1d0cb" font-size="10" font-family="monospace">INFEED</text><text x="264" y="380" fill="#c1d0cb" font-size="10" font-family="monospace">INSPECTION</text><text x="455" y="380" fill="#c1d0cb" font-size="10" font-family="monospace">OUTFEED</text>
          </svg>
          <span class="callout callout-one">01 <i>VISION CHECK</i></span><span class="callout callout-two">02 <i>PLC / I/O</i></span>
        </div>
        <div class="visual-caption"><span>SEE THE SYSTEM.<br />UNDERSTAND THE LOGIC.</span><span class="caption-index">FL — 2026</span></div>
      </div>
      <div class="hero-index"><span>01</span><span class="index-line"></span><span>07</span></div>
    </section>
    <div class="ticker" aria-label="Factory Logic focus areas"><div>UNDERSTAND SYSTEMS <b>✳</b> BUILD PRACTICAL SKILLS <b>✳</b> AUTOMATE WITH INTENT <b>✳</b> UNDERSTAND SYSTEMS <b>✳</b> BUILD PRACTICAL SKILLS <b>✳</b> AUTOMATE WITH INTENT <b>✳</b></div></div>
    <section class="intro section-wrap">
      <div class="section-kicker"><span>THE FACTORY LOGIC METHOD</span><span>01 — 03</span></div>
      <div class="intro-grid"><h2>Good engineering<br />starts with <em>understanding.</em></h2><div class="intro-copy"><p>Factory Logic is a growing field guide to the systems, decisions, and problem-solving behind modern manufacturing.</p><p>Learn the fundamentals. Connect them to real equipment. Build the judgment to make systems work.</p><a class="underlined-link" href="#articles">Read the latest fieldnotes <span>↗</span></a></div></div>
      <div class="method"><div><span class="method-no">01</span><strong>Understand</strong><small>Learn the principle</small></div><span class="method-arrow">→</span><div><span class="method-no">02</span><strong>Connect</strong><small>See the whole system</small></div><span class="method-arrow">→</span><div><span class="method-no">03</span><strong>Apply</strong><small>Build with purpose</small></div><span class="method-arrow">→</span><div><span class="method-no">04</span><strong>Teach</strong><small>Make it clear</small></div></div>
    </section>
    <section class="topics section-wrap" aria-label="Knowledge areas">
      <div class="section-kicker"><span>KNOWLEDGE AREAS</span><span>02 — 03</span></div>
      <div class="topic-heading"><h2>From the signal<br />to the <em>system.</em></h2><p>Engineering knowledge that travels from the drawing to the line.</p></div>
      <div class="topic-list">{topics.map((topic) => <article class="topic-card" id={topic.id}><div class="topic-count">{topic.number}<span> / 03</span></div><div class="topic-main"><span class="topic-eyebrow">{topic.eyebrow}</span><h3>{topic.title}</h3><p>{topic.text}</p><div class="topic-tags">{topic.tags.map((tag) => <span>{tag}</span>)}</div></div><a class="round-link" href="#articles" aria-label={`Explore ${topic.title}`}>↗</a></article>)}</div>
    </section>
    <section class="fieldnotes section-wrap" id="articles">
      <div class="section-kicker"><span>THE FIELDNOTES</span><span>03 — 03</span></div>
      <div class="fieldnotes-heading"><div><span class="topic-eyebrow">NOTES FROM THE FLOOR</span><h2>Learn it. Use it.<br /><em>Pass it on.</em></h2></div><p>Practical explanations, working ideas, and project notes — added one topic at a time.</p></div>
      <div class="article-list">{articles.length ? articles.slice(0, 4).map((article, index) => <a class="article-row" href={`${base}articles/${article.id}/`}><span class="article-no">{String(index + 1).padStart(2, '0')}</span><span class="article-copy"><span class="article-category">{article.data.category} <b>·</b> {article.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span><strong>{article.data.title}</strong><small>{article.data.description}</small></span><span class="article-arrow">↗</span></a>) : <p class="empty-state">New fieldnotes are being prepared.</p>}</div>
    </section>
    <section class="showcase" id="projects"><div class="showcase-inner"><div><span class="topic-eyebrow">FROM CONCEPT TO COMMISSIONING</span><h2>Build with<br /><em>the whole line in mind.</em></h2><p>Project notes connect controls, vision, and manufacturing engineering to the work they do together.</p><a class="button-light" href="#articles">Explore project notes <span>↗</span></a></div><div class="showcase-diagram"><div class="diagram-node node-a"><span>01 / INPUT</span><strong>Sense</strong></div><div class="diagram-node node-b"><span>02 / LOGIC</span><strong>Decide</strong></div><div class="diagram-node node-c"><span>03 / OUTPUT</span><strong>Act</strong></div><div class="diagram-flow flow-a"></div><div class="diagram-flow flow-b"></div><small>MEASURE → INTERPRET → RESPOND</small></div></div></section>
    <section class="videos section-wrap" id="videos"><div class="video-mark"><span>▶</span></div><div><span class="topic-eyebrow">WATCH &amp; LEARN</span><h2>Engineering, in <em>motion.</em></h2><p>Video explainers and practical walkthroughs are on the way.</p></div><span class="channel-note">CHANNEL COMING SOON</span></section>
    <section class="about section-wrap" id="about"><div class="about-number">ABOUT<br />THE BUILDER<br /><span>FL / 001</span></div><div class="about-copy"><span class="topic-eyebrow">ENGINEERING · LEARNING · SHARING</span><h2>Andy Deng</h2><p class="about-role">Project Manager · Industrial Automation &amp; Machine Vision · Manufacturing Engineering</p><p>Factory Logic is where I document what I learn about engineering systems and the people who make them work. The goal: explain practical ideas clearly, connect them to the bigger picture, and keep building.</p><a class="underlined-link" href="https://github.com/andydeng-automation" target="_blank" rel="noreferrer">Connect on GitHub <span>↗</span></a></div><div class="about-quote"><span>LEARNING LOOP</span><blockquote>“Understand → Recall → Connect → Apply → Teach”</blockquote><small>A PRACTICE, NOT A FINISH LINE</small></div></section>
  </main>
</BaseLayout>
<style>
  .hero{min-height:590px;padding:66px clamp(28px,9.7vw,150px) 62px;display:grid;grid-template-columns:1.03fr .97fr;align-items:center;gap:5vw;position:relative;overflow:hidden;background:radial-gradient(ellipse at 86% 40%,#e7ece8 0,transparent 39%),var(--paper)}.hero-copy{max-width:570px;position:relative;z-index:1}.eyebrow,.section-kicker,.topic-eyebrow,.hero-meta,.visual-top,.visual-caption,.hero-index,.topic-count,.article-category,.article-no,.about-number,.about-quote>span,.about-quote small{font:10px 'DM Mono',monospace;letter-spacing:.12em}.eyebrow{display:flex;align-items:center;gap:10px;color:#61727b}.status-dot{width:7px;height:7px;background:var(--orange);border-radius:50%;box-shadow:0 0 0 4px #efded6}.eyebrow-rule{height:1px;width:30px;background:#bac4c0;margin-left:5px}.hero h1{font:600 clamp(58px,7vw,96px)/.94 Manrope,sans-serif;letter-spacing:-.075em;margin:36px 0 24px}.hero h1 em,.intro h2 em,.topic-heading h2 em,.fieldnotes h2 em,.showcase h2 em,.videos h2 em{font-family:Georgia,serif;font-weight:400;color:var(--teal);letter-spacing:-.065em}.hero-lede{font-size:18px;line-height:1.65;color:#52636c;max-width:430px;margin:0 0 31px}.hero-actions{display:flex;align-items:center;gap:25px}.button-primary,.button-light{display:inline-flex;gap:24px;align-items:center;padding:15px 18px;background:var(--ink);color:white;font-size:12px;font-weight:600}.button-primary span{color:#f4a176;font-size:16px}.text-link{font-size:12px;font-weight:600;border-bottom:1px solid #a7b1ad;padding-bottom:5px}.text-link span,.underlined-link span{color:var(--orange);padding-left:9px}.hero-meta{display:flex;gap:11px;margin-top:56px;color:#7b888b;font-size:9px}.hero-meta b{color:var(--orange)}.hero-visual{max-width:530px;width:100%;justify-self:end;background:#173448;padding:12px;box-shadow:0 22px 55px #18334520;transform:rotate(1deg)}.visual-top{color:#bdcbc6;display:flex;justify-content:space-between;padding:7px 8px 11px;font-size:9px}.blueprint{height:330px;position:relative;overflow:hidden;background:#24475a}.blueprint-grid{position:absolute;inset:0;background-image:linear-gradient(#c4d3ce12 1px,transparent 1px),linear-gradient(90deg,#c4d3ce12 1px,transparent 1px);background-size:24px 24px}.blueprint svg{position:absolute;inset:0;width:100%;height:100%}.callout{position:absolute;font:9px 'DM Mono',monospace;color:#8ecbb8;border-left:1px solid #8ecbb8;padding-left:6px;letter-spacing:.06em}.callout i{display:block;font-style:normal;font-size:8px;color:#c6d7d0;margin-top:3px}.callout-one{left:22%;top:35%}.callout-two{right:11%;top:16%}.visual-caption{display:flex;justify-content:space-between;color:#d7e1dd;line-height:1.5;padding:12px 8px 4px;font-size:9px}.caption-index{color:#99aea7}.hero-index{position:absolute;right:4.5vw;bottom:66px;display:flex;align-items:center;gap:9px;color:#83928f}.hero-index span:first-child{color:var(--orange)}.index-line{height:1px;width:35px;background:#aeb9b5}.ticker{overflow:hidden;background:var(--teal);color:#f4f5f2;padding:13px 0;font:10px 'DM Mono',monospace;letter-spacing:.14em;white-space:nowrap}.ticker div{word-spacing:6px}.ticker b{color:#e9a06a;margin:0 15px}.section-wrap{padding:86px clamp(28px,12vw,182px)}.section-kicker{display:flex;justify-content:space-between;padding-bottom:17px;border-bottom:1px solid var(--line);color:#79868a}.section-kicker span:last-child{color:var(--orange)}.intro-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:8vw;padding:44px 0 56px}.intro h2,.topic-heading h2,.fieldnotes h2,.showcase h2,.videos h2,.about h2{font:600 clamp(37px,4.7vw,59px)/1.08 Manrope,sans-serif;letter-spacing:-.06em;margin:0}.intro-copy{max-width:390px;padding-top:6px}.intro-copy p,.topic-heading p,.fieldnotes-heading>p,.showcase p,.videos p,.about-copy>p{font-size:14px;line-height:1.75;color:#5d6b72;margin:0 0 15px}.underlined-link{display:inline-block;margin-top:10px;padding-bottom:7px;border-bottom:1px solid #9faaa6;font-size:12px;font-weight:600}.method{border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding-top:24px}.method>div{display:grid;gap:6px}.method-no{font:10px 'DM Mono',monospace;color:var(--orange)}.method strong{font:600 15px Manrope,sans-serif}.method small{font-size:11px;color:#87928f}.method-arrow{color:#9ca8a2;font-size:18px}.topics{padding-top:28px;background:#edf0ed}.topic-heading{display:flex;align-items:flex-end;justify-content:space-between;padding:35px 0 42px}.topic-heading p{max-width:230px;margin:0 0 7px}.topic-list{border-top:1px solid #cdd6d2}.topic-card{display:grid;grid-template-columns:110px 1fr 42px;gap:20px;padding:28px 0 30px;border-bottom:1px solid #cdd6d2;align-items:center}.topic-count{color:var(--orange);font-size:12px;align-self:start;padding-top:7px}.topic-count span{color:#9aa6a2;font-size:9px}.topic-eyebrow{color:#788987;font-size:9px}.topic-main h3{font:600 23px Manrope,sans-serif;letter-spacing:-.035em;margin:7px 0 6px}.topic-main p{font-size:12px;line-height:1.6;color:#65747a;max-width:580px;margin:0}.topic-tags{display:flex;gap:8px;margin-top:14px;flex-wrap:wrap}.topic-tags span{border:1px solid #cdd6d2;padding:6px 9px;color:#53636a;font-size:10px}.round-link{width:34px;height:34px;border:1px solid #aebbb5;display:grid;place-items:center;border-radius:50%;color:var(--teal);transition:.2s}.round-link:hover{background:var(--teal);color:white;border-color:var(--teal)}.fieldnotes{padding-bottom:94px}.fieldnotes-heading{display:flex;justify-content:space-between;align-items:flex-end;padding:37px 0 34px}.fieldnotes h2{margin-top:10px}.fieldnotes-heading>p{max-width:260px;margin:0 0 5px}.article-list{border-top:1px solid var(--line)}.article-row{display:grid;grid-template-columns:50px 1fr 35px;align-items:center;gap:14px;padding:20px 0;border-bottom:1px solid var(--line);transition:padding .2s}.article-row:hover{padding-left:8px;padding-right:8px;background:#edf0ed}.article-no{color:var(--orange)}.article-copy{display:grid;gap:5px}.article-category{font-size:9px;letter-spacing:.07em;color:#71807f}.article-category b{color:var(--orange)}.article-copy strong{font:600 17px Manrope,sans-serif;letter-spacing:-.02em}.article-copy small{font-size:11px;color:#73817f}.article-arrow{justify-self:end;color:var(--teal)}.empty-state{font-size:13px;color:var(--muted);padding:24px 0}.showcase{background:var(--ink);color:#edf2ef;padding:74px clamp(28px,12vw,182px)}.showcase-inner{display:grid;grid-template-columns:1fr 1fr;gap:5vw;align-items:center}.showcase .topic-eyebrow{color:#9ab2a9}.showcase h2{margin:15px 0}.showcase h2 em{color:#9dd0b7}.showcase p{color:#b0bfba;max-width:380px;margin:0 0 24px}.button-light{background:#e9a06a;color:var(--ink)}.button-light span{font-size:16px}.showcase-diagram{height:240px;position:relative;border:1px solid #496273;background-image:linear-gradient(#49627345 1px,transparent 1px),linear-gradient(90deg,#49627345 1px,transparent 1px);background-size:24px 24px}.diagram-node{position:absolute;width:110px;height:72px;background:#234355;border:1px solid #79918c;padding:11px;display:grid;align-content:center;gap:8px}.diagram-node span{font:8px 'DM Mono',monospace;color:#9dcbb7}.diagram-node strong{font:600 16px Manrope,sans-serif}.node-a{left:8%;top:34%}.node-b{left:39%;top:13%;border-color:#e9a06a}.node-c{right:8%;top:46%}.diagram-flow{position:absolute;height:1px;background:#9bcbb6;transform-origin:left}.flow-a{left:28%;top:41%;width:120px;transform:rotate(-22deg)}.flow-b{left:60%;top:30%;width:120px;transform:rotate(27deg)}.showcase-diagram>small{position:absolute;bottom:12px;left:14px;font:8px 'DM Mono',monospace;color:#9bacaa;letter-spacing:.1em}.videos{display:grid;grid-template-columns:54px 1fr auto;gap:20px;align-items:center;border-bottom:1px solid var(--line);padding-top:45px;padding-bottom:45px}.video-mark{width:43px;height:43px;display:grid;place-items:center;border:1px solid #c2ceca;border-radius:50%;color:var(--orange);font-size:12px}.videos h2{font-size:28px;margin:5px 0}.videos p{font-size:12px;margin:0}.videos .text-link{white-space:nowrap}.about{display:grid;grid-template-columns:130px 1fr 260px;gap:4vw;padding-top:76px;padding-bottom:80px}.about-number{font-size:10px;line-height:1.7;color:#8b9994}.about-number span{display:inline-block;margin-top:15px;color:var(--orange)}.about h2{font-size:44px;margin:8px 0}.about-role{font-size:12px!important;color:var(--teal)!important}.about-copy>p{font-size:12px;max-width:510px}.about-quote{border-left:1px solid #cbd4d0;padding:3px 0 0 20px;align-self:center}.about-quote>span,.about-quote small{font-size:8px;color:#87948f}.about-quote blockquote{font:italic 19px/1.45 Georgia,serif;color:var(--teal);margin:18px 0}.about-quote small{font-size:8px}@media(max-width:850px){.hero{padding-left:7vw;padding-right:7vw;gap:3vw}.hero h1{font-size:68px}.hero-meta{font-size:8px;gap:7px}.section-wrap{padding-left:8vw;padding-right:8vw}.about{grid-template-columns:85px 1fr}.about-quote{grid-column:2;max-width:350px}.hero-index{display:none}}@media(max-width:620px){.hero{grid-template-columns:1fr;padding-top:49px;padding-bottom:45px}.hero h1{font-size:64px;margin-top:28px}.hero-lede{font-size:15px}.hero-meta{margin-top:35px;flex-wrap:wrap}.hero-visual{justify-self:center;margin:12px 0 0;max-width:440px}.blueprint{height:260px}.section-wrap{padding:60px 23px}.intro-grid{grid-template-columns:1fr;gap:20px;padding:33px 0 38px}.intro h2,.topic-heading h2,.fieldnotes h2,.showcase h2{font-size:42px}.method{gap:10px;align-items:flex-start}.method>div{min-width:0}.method strong{font-size:12px}.method small{font-size:9px}.method-arrow{font-size:14px;padding-top:17px}.topic-heading,.fieldnotes-heading{display:block}.topic-heading p,.fieldnotes-heading>p{margin-top:17px}.topic-card{grid-template-columns:45px 1fr 34px;gap:10px;padding:22px 0}.topic-main h3{font-size:19px}.topic-tags span{font-size:9px}.showcase{padding:58px 23px}.showcase-inner{grid-template-columns:1fr;gap:36px}.showcase-diagram{height:205px}.videos{grid-template-columns:44px 1fr;gap:14px}.videos .text-link{grid-column:2;justify-self:start;margin-top:5px}.videos h2{font-size:23px}.about{grid-template-columns:1fr;gap:20px}.about-number br{display:none}.about-number span{margin:0 0 0 12px}.about-quote{grid-column:1}.article-row{grid-template-columns:28px 1fr 20px;gap:10px}.article-copy strong{font-size:14px}.article-copy small{line-height:1.5}.footer{padding:24px;gap:10px}.footer p{width:100%;order:3}.footer-tag{margin-left:auto}}
</style>
