---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const home = import.meta.env.BASE_URL;
---
<BaseLayout title={`${article.data.title} — Factory Logic`} description={article.data.description}>
  <main class="article-page">
    <a class="back-link" href={`${home}#articles`}>← Back to fieldnotes</a>
    <header class="article-header"><span class="topic-eyebrow">{article.data.category} · FIELDNOTE</span><h1>{article.data.title}</h1><p>{article.data.description}</p><time datetime={article.data.pubDate.toISOString()}>{article.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time></header>
    <article class="prose"><Content /></article>
    <a class="underlined-link" href={`${home}#articles`}>Explore more fieldnotes <span>↗</span></a>
  </main>
</BaseLayout>
<style>
  .article-page{max-width:850px;min-height:70vh;margin:auto;padding:55px 28px 90px}.back-link{font-size:12px;color:#607078}.article-header{padding:70px 0 43px;border-bottom:1px solid var(--line)}.article-header h1{font:600 clamp(42px,7vw,72px)/1.04 Manrope,sans-serif;letter-spacing:-.065em;margin:14px 0}.article-header p{font-size:17px;line-height:1.6;color:var(--muted);max-width:640px}.article-header time{font:10px 'DM Mono',monospace;color:#7b888b}.prose{max-width:680px;padding:34px 0;color:#334651;font-size:16px;line-height:1.8}.prose h2{font:600 25px Manrope,sans-serif;letter-spacing:-.04em;margin:34px 0 10px;color:var(--ink)}.prose p{margin:0 0 18px}.prose img{display:block;width:100%;height:auto;border-radius:6px;margin:0 0 28px}.prose a{color:var(--teal);text-decoration:underline}.prose blockquote{border-left:2px solid var(--orange);margin:25px 0;padding:4px 18px;color:#53666a}.underlined-link{display:inline-block;padding-bottom:7px;border-bottom:1px solid #9faaa6;font-size:12px;font-weight:600}.underlined-link span{color:var(--orange);padding-left:9px}
</style>
